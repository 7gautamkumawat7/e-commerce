# ==============================================================================
# SHOPCART PRODUCTION E-COMMERCE & PAYMENT GATEWAY ARCHITECTURE CONFIGURATION
# Copy this file to .env and replace placeholders with secure production credentials.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development
PORT=5000

# PostgreSQL Relational Database (Authoritative Source of Truth)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopcart
# Set to 'true' to use in-memory embedded PGlite engine (useful for offline/tests)
USE_EMBEDDED_POSTGRES=false

# Redis In-Memory Store (Idempotency, Rate Limiting & Catalog Cache)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# JWT Authentication Secrets (Generate with `openssl rand -hex 32`)
JWT_ACCESS_SECRET=shopcart_development_access_secret_super_secure_jwt_key_2026!
JWT_REFRESH_SECRET=shopcart_development_refresh_secret_super_secure_jwt_key_2026!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Razorpay Payment Gateway Credentials (Keep Secret Private on Server!)
RAZORPAY_KEY_ID=rzp_test_shopcartDevKey01
RAZORPAY_KEY_SECRET=rzp_test_secret_shopcartDevSecret99
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_shopcartSecure2026

# Client URLs & CORS Allowed Origins
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Vite Client Environment Variables
VITE_API_URL=http://localhost:5000/api
VITE_RAZORPAY_KEY_ID=rzp_test_shopcartDevKey01
VITE_CURRENCY=INR
